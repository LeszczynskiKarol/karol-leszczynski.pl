<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    background: var(--c-bg-alt);
    padding: var(--s-3xl) 0 0;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: var(--s-2xl);
    padding-bottom: var(--s-2xl);
  }

  /* Brand column */
  .footer-logo {
    font-family: var(--f-mono);
    font-size: var(--f-size-xl);
    font-weight: 700;
    display: inline-block;
    margin-bottom: var(--s-md);
  }
  .footer-logo .bracket { color: var(--c-primary); }

  .footer-desc {
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
    line-height: 1.7;
    margin-bottom: var(--s-lg);
    max-width: 280px;
  }

  .footer-socials {
    display: flex;
    gap: var(--s-sm);
  }

  .footer-social {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--c-bg-card);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
    transition: var(--transition);
  }
  .footer-social:hover {
    border-color: var(--c-primary);
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }

  /* Link columns */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
  }

  .footer-heading {
    font-size: var(--f-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text);
    margin-bottom: var(--s-sm);
  }

  .footer-col a {
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
    transition: var(--transition);
    padding: 2px 0;
  }
  .footer-col a:hover {
    color: var(--c-primary);
  }

  /* Contact items */
  .footer-contact-item {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
    padding: 3px 0;
    transition: var(--transition);
  }
  a.footer-contact-item:hover { color: var(--c-primary); }
  .footer-contact-item svg { flex-shrink: 0; opacity: 0.6; }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    margin-top: var(--s-sm);
    padding: 8px 24px;
    background: var(--c-primary);
    color: #fff !important;
    font-size: var(--f-size-sm);
    font-weight: 600;
    border-radius: var(--radius);
    transition: var(--transition);
    width: fit-content;
  }
  .footer-cta:hover {
    background: var(--c-primary-hover);
    transform: translateY(-1px);
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-md);
    padding: var(--s-lg) 0;
    border-top: 1px solid var(--c-border);
  }

  .footer-copy {
    font-size: var(--f-size-xs);
    color: var(--c-text-muted);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    flex-wrap: wrap;
  }

  .footer-legal a {
    font-size: var(--f-size-xs);
    color: var(--c-text-muted);
    transition: var(--transition);
  }
  .footer-legal a:hover { color: var(--c-primary); }

  .footer-sep {
    color: var(--c-border);
    font-size: var(--f-size-xs);
  }

  .footer-nip {
    font-family: var(--f-mono);
    font-size: var(--f-size-xs);
    color: var(--c-text-muted);
    opacity: 0.6;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-xl);
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--s-xl);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>