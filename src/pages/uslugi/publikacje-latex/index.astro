---
import Service from '@/layouts/Service.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Desktop Publishing",
  "name": "Skład publikacji LaTeX i Quarto",
  "description": "Profesjonalny skład książek, prac naukowych i publikacji edukacyjnych w LaTeX.",
  "provider": { "@type": "Person", "name": "Karol Leszczyński", "knowsAbout": ["LaTeX", "Quarto", "Academic Publishing"] },
  "areaServed": "PL",
  "hasOfferCatalog": { "@type": "OfferCatalog", "itemListElement": [{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skład pracy naukowej", "description": "Bibliografia, indeksy, formatowanie" } }] },
  "priceSpecification": { "@type": "PriceSpecification", "price": "50", "priceCurrency": "PLN", "unitText": "strona" },
};

const latexPros = [
  "Typografia na poziomie wydawnictw naukowych",
  "Automatyczne numerowanie, spisy, indeksy",
  "Perfekcyjne wzory matematyczne",
  "Bibliografia zgodna ze standardami",
  "Wielokrotne użycie szablonów",
  "Kontrola wersji (Git)",
  "PDF gotowy do druku profesjonalnego",
];

const wordCons = [
  "Problemy z formatowaniem przy dużych dokumentach",
  "Ręczna numeracja i aktualizacja spisów",
  "Ograniczone możliwości wzorów",
  "Problemy z bibliografią",
  "Każda publikacja od zera",
  "Brak kontroli wersji",
  "Problemy z drukiem profesjonalnym",
];

const publications = [
  { title: "Edukowanie pacjentów w zakresie profilaktyki", type: "zeszyty ćwiczeń", pages: "120", target: "Szkoły policealne - higienistka stomatologiczna", features: ["Ćwiczenia praktyczne", "Schematy", "Tabele", "Kolorowe wykresy"], tech: "LaTeX + TikZ" },
  { title: "Diagnozowanie i planowanie leczenia", type: "zeszyty ćwiczeń", pages: "150", target: "Technik masażysta", features: ["Case studies", "Ćwiczenia", "Diagramy", "Formularze"], tech: "Quarto + R" },
  { title: "Wykonywanie zabiegów fizjoterapeutycznych", type: "zeszyty ćwiczeń", pages: "180", target: "Technik fizjoterapii", features: ["Ilustracje anatomiczne", "Procedury", "Testy", "Bibliografia"], tech: "LaTeX + PGF" },
  { title: "Jak zostać copywriterem", type: "e-booki", pages: "250", target: "Początkujący copywriterzy", features: ["Praktyczne porady", "Case studies", "Szablony", "Ćwiczenia"], tech: "LaTeX + hyperref" },
  { title: "Prowadzenie działalności profilaktyczno-leczniczej", type: "zeszyty ćwiczeń", pages: "140", target: "Opiekun medyczny", features: ["Procedury medyczne", "Checklisty", "Formularze", "Testy"], tech: "Quarto" },
  { title: "Świadczenie usług pielęgnacyjno-opiekuńczych", type: "zeszyty ćwiczeń", pages: "160", target: "Opiekunka środowiskowa", features: ["Standardy opieki", "Dokumentacja", "Ćwiczenia", "Przypadki"], tech: "LaTeX + longtable" },
];

const processSteps = [
  { step: "1", title: "Koncepcja i planowanie", desc: "Analiza grupy docelowej, określenie celów publikacji, struktura treści", time: "2-3 dni" },
  { step: "2", title: "Tworzenie treści", desc: "Pisanie merytorycznej treści, ćwiczeń, przykładów, case studies", time: "2-4 tygodnie" },
  { step: "3", title: "Projekt graficzny", desc: "Szablon LaTeX, style, kolory, układ stron, elementy graficzne", time: "3-5 dni" },
  { step: "4", title: "Skład w LaTeX/Quarto", desc: "Profesjonalny skład, wzory, tabele, wykresy, bibliografia", time: "1-2 tygodnie" },
  { step: "5", title: "Korekta i redakcja", desc: "Korekta językowa, merytoryczna, adjustacja tekstu", time: "3-5 dni" },
  { step: "6", title: "Przygotowanie do druku", desc: "PDF print-ready, spady, CMYK, preflight check", time: "1-2 dni" },
];

const serviceTypes = [
  { title: "Podręczniki akademickie", icon: "🎓", desc: "Podręczniki dla uczelni wyższych i szkół policealnych", features: ["Przypisy", "Bibliografia", "Indeksy", "Wzory matematyczne"], price: "od 5000 zł" },
  { title: "Zeszyty ćwiczeń", icon: "✏️", desc: "Materiały ćwiczeniowe dla uczniów i studentów", features: ["Zadania", "Testy", "Klucz odpowiedzi", "Ilustracje"], price: "od 3000 zł" },
  { title: "Książki branżowe", icon: "📖", desc: "Publikacje specjalistyczne i poradniki", features: ["Case studies", "Przykłady", "Schematy", "Checklisty"], price: "od 4000 zł" },
  { title: "E-booki", icon: "📥", desc: "Publikacje elektroniczne w PDF z interaktywnością", features: ["Hyperlinki", "Zakładki", "Formularze", "Multimedia"], price: "od 2000 zł" },
  { title: "Prace naukowe", icon: "📄", desc: "Dysertacje, monografie, artykuły naukowe", features: ["Cytowania", "Bibliografia", "Abstract", "Peer-review ready"], price: "od 1500 zł" },
  { title: "Dokumentacja techniczna", icon: "📋", desc: "Manualne, specyfikacje, dokumentacja API", features: ["Diagramy", "Code snippets", "Flowcharty", "Wersjonowanie"], price: "od 2500 zł" },
];

const plans = [
  { name: "Starter", price: "1 990", desc: "Dla małych projektów", best: false, features: ["Do 50 stron", "Podstawowy szablon LaTeX", "Skład tekstu i prostych tabel", "1 runda korekt", "PDF do druku cyfrowego", "Pliki źródłowe LaTeX"] },
  { name: "Professional", price: "4 990", desc: "Pełna publikacja profesjonalna", best: true, features: ["Do 150 stron", "Dedykowany szablon", "Skład zaawansowany (wzory, wykresy)", "Projekt okładki", "2 rundy korekt", "PDF print-ready + e-book", "Bibliografia i indeksy", "Kontrola wersji Git"] },
  { name: "Publisher", price: "od 9 990", desc: "Dla wydawnictw i serii", best: false, features: ["Bez limitu stron", "System szablonów dla serii", "Pełna automatyzacja składu", "Projekt graficzny kompletny", "Korekta profesjonalna", "Wszystkie formaty (print, e-book, web)", "Wsparcie przy druku", "Długoterminowa współpraca"] },
];

const faqs = [
  { q: "Czym LaTeX różni się od Worda czy InDesign?", a: "LaTeX to system składu profesjonalnego używany przez wydawnictwa naukowe i uczelnie na całym świecie. Gwarantuje perfekcyjną typografię, automatyczną numerację, bibliografia zgodną ze standardami. Word się 'sypie' przy dużych dokumentach, InDesign wymaga ręcznej pracy. LaTeX automatyzuje wszystko." },
  { q: "Czy mogę potem edytować publikację samodzielnie?", a: "Tak! Dostarczam pliki źródłowe LaTeX/Quarto wraz z dokumentacją. Jeśli znasz podstawy LaTeX, możesz wprowadzać zmiany. Oferuję też wsparcie i szkolenia. Dla prostych zmian mogę przygotować szablon z instrukcją." },
  { q: "Ile trwa stworzenie publikacji?", a: "Zeszyt ćwiczeń (100-150 stron) - około 4-6 tygodni. E-book (200-300 stron) - 6-8 tygodni. Podręcznik akademicki - 8-12 tygodni. Czas zależy od złożoności i ilości grafik/wzorów." },
  { q: "Czy tworzysz też treść, czy tylko skład?", a: "Oferuję pełną usługę - od koncepcji, przez napisanie treści, po skład i przygotowanie do druku. Mogę też zrobić sam skład, jeśli masz gotową treść." },
  { q: "Jakie formaty dostarczasz?", a: "PDF print-ready (CMYK, spady, znaczniki), PDF do publikacji online, źródła LaTeX/Quarto, opcjonalnie: HTML, EPUB, DOCX. Wszystko zależy od potrzeb." },
  { q: "Czy publikacje nadają się do druku offsetowego?", a: "Absolutnie tak! Przygotowuję pliki zgodnie z wymogami drukarni: CMYK, rozdzielczość 300 DPI, spady, znaczniki cięcia. Mam doświadczenie we współpracy z drukarniami." },
];
---

<Service title="Publikacje LaTeX/Quarto — Profesjonalny skład" description="Profesjonalny skład książek, prac naukowych i publikacji edukacyjnych w LaTeX/Quarto. 11 publikacji wydanych, 1500+ stron składu. Print-ready PDF." breadcrumbLabel="Publikacje LaTeX/Quarto" structuredData={structuredData}>

  <!-- Hero -->
  <section class="hero" style="min-height: 70vh;">
    <div class="hero-bg"><div class="hero-grid"></div></div>
    <div class="container">
      <div class="hero-content" style="max-width: 700px;">
        <p class="text-primary font-mono animate-in" style="font-size: var(--f-size-sm); margin-bottom: var(--s-md);">📋 LaTeX · Quarto · R Markdown · Pandoc</p>
        <h1 class="animate-in animate-delay-1">Publikacje <span class="text-gradient">LaTeX/Quarto</span></h1>
        <p class="text-muted animate-in animate-delay-2" style="font-size: var(--f-size-lg); margin: var(--s-lg) 0 var(--s-xl);">
          <strong>Od koncepcji do gotowej publikacji.</strong> Tworzę profesjonalne książki, podręczniki, zeszyty ćwiczeń i dokumenty naukowe. Zajmuję się wszystkim - treścią, składem i przygotowaniem do druku.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-lg); margin-bottom: var(--s-xl); font-size: var(--f-size-sm);">
          <span>✅ 11 publikacji wydanych</span><span>✅ 1500+ stron składu</span><span>✅ Print-ready PDF</span>
        </div>
        <div class="hero-actions animate-in animate-delay-3">
          <a href="/kontakt" class="btn btn-primary">Wycena publikacji →</a>
          <a href="#portfolio" class="btn btn-outline">Zobacz portfolio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Dlaczego LaTeX -->
  <section class="section" style="background: var(--c-bg-alt);">
    <div class="container">
      <div class="section-header">
        <h2>Dlaczego <span class="text-gradient">LaTeX/Quarto</span>?</h2>
        <p>Profesjonalny skład, który wyróżnia Twoje publikacje na rynku</p>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2xl); max-width: 900px; margin: 0 auto;">
        <div class="skill-group">
          <h3 style="margin-bottom: var(--s-md);">📋 LaTeX/Quarto</h3>
          {latexPros.map(item => (
            <div style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; font-size: var(--f-size-sm);">
              <span style="color: var(--c-accent); flex-shrink: 0;">✓</span><span>{item}</span>
            </div>
          ))}
        </div>
        <div class="skill-group" style="border-color: rgba(239, 68, 68, 0.3);">
          <h3 style="color: #ef4444; margin-bottom: var(--s-md);">📄 Word/Typowe programy</h3>
          {wordCons.map(item => (
            <div style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; font-size: var(--f-size-sm);">
              <span style="color: #ef4444; flex-shrink: 0;">✗</span><span class="text-muted">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="section" id="portfolio">
    <div class="container">
      <div class="section-header">
        <h2>Moje <span class="text-gradient">publikacje</span></h2>
        <p>11 profesjonalnych publikacji gotowych do druku</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--s-xl); max-width: 1000px; margin: 0 auto;">
        {publications.map(pub => (
          <div class="skill-group">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--s-md);">
              <span style="font-size: 1.5rem;">📖</span>
              <span class="text-muted" style="font-size: var(--f-size-sm);">{pub.pages} stron</span>
            </div>
            <h3 style="font-size: var(--f-size-lg); margin-bottom: var(--s-xs);">{pub.title}</h3>
            <p class="text-primary" style="font-size: var(--f-size-sm); margin-bottom: var(--s-md);">{pub.target}</p>
            {pub.features.map(f => (
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; font-size: var(--f-size-sm);">
                <div style="width: 6px; height: 6px; background: var(--c-primary); border-radius: 50%; flex-shrink: 0;"></div>
                <span class="text-muted">{f}</span>
              </div>
            ))}
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--s-md); padding-top: var(--s-md); border-top: 1px solid var(--c-border);">
              <span class="text-muted" style="font-size: var(--f-size-xs);">{pub.tech}</span>
              <span style="font-size: var(--f-size-xs); padding: 2px 10px; background: var(--c-primary-soft); border-radius: 999px; color: var(--c-primary);">{pub.type}</span>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align: center; margin-top: var(--s-2xl);" class="text-muted">+ 5 kolejnych publikacji w realizacji</p>
    </div>
  </section>

  <!-- Proces tworzenia -->
  <section class="section" style="background: var(--c-bg-alt);">
    <div class="container">
      <div class="section-header">
        <h2>Od pomysłu do <span class="text-gradient">gotowej książki</span></h2>
        <p>Kompleksowy proces tworzenia publikacji</p>
      </div>
      <div style="max-width: 800px; margin: 0 auto;">
        {processSteps.map(phase => (
          <div style="display: flex; gap: var(--s-lg); margin-bottom: var(--s-xl);">
            <div style="flex-shrink: 0; width: 56px; height: 56px; background: var(--c-bg-card); border: 2px solid var(--c-border-hover); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
              <span class="text-primary" style="font-weight: 700;">{phase.step}</span>
            </div>
            <div class="skill-group" style="flex: 1; padding: var(--s-lg);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-xs);">
                <h3 style="font-size: var(--f-size-lg);">{phase.title}</h3>
                <span class="text-primary" style="font-size: var(--f-size-sm);">{phase.time}</span>
              </div>
              <p class="text-muted">{phase.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align: center; margin-top: var(--s-xl);">
        <p class="text-primary" style="font-size: var(--f-size-lg); font-weight: 600;">Całkowity czas: 4-8 tygodni</p>
        <p class="text-muted">Od pierwszego spotkania do plików gotowych do druku</p>
      </div>
    </div>
  </section>

  <!-- Co mogę stworzyć -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Co mogę dla Ciebie <span class="text-gradient">stworzyć</span>?</h2>
        <p>Każdy typ publikacji profesjonalnej</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--s-lg); max-width: 1000px; margin: 0 auto;">
        {serviceTypes.map(type => (
          <div class="skill-group">
            <div style="font-size: 1.5rem; margin-bottom: var(--s-sm);">{type.icon}</div>
            <h3 style="font-size: var(--f-size-xl); margin-bottom: var(--s-sm);">{type.title}</h3>
            <p class="text-muted" style="font-size: var(--f-size-sm); margin-bottom: var(--s-md);">{type.desc}</p>
            {type.features.map(f => (
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: var(--f-size-sm);">
                <span style="color: var(--c-accent);">✓</span><span>{f}</span>
              </div>
            ))}
            <div style="margin-top: var(--s-md); padding-top: var(--s-md); border-top: 1px solid var(--c-border);">
              <span class="text-primary" style="font-size: var(--f-size-sm); font-weight: 600;">{type.price}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dlaczego ja -->
  <section class="section" style="background: var(--c-bg-alt);">
    <div class="container">
      <div class="section-header">
        <h2>Dlaczego warto mi <span class="text-gradient">zaufać</span>?</h2>
        <p>Unikalne połączenie kompetencji</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s-xl); max-width: 960px; margin: 0 auto;">
        <div style="text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--c-primary), var(--c-accent)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s-md); font-size: 2rem;">✏️</div>
          <h3 style="font-size: var(--f-size-xl); margin-bottom: var(--s-sm);">Copywriter + Autor</h3>
          <p class="text-muted">15 lat doświadczenia w pisaniu. <strong>5000+ tekstów</strong> komercyjnych. Wiem jak pisać, żeby było zrozumiałe i angażujące.</p>
        </div>
        <div style="text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--c-primary), var(--c-accent)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s-md); font-size: 2rem;">📋</div>
          <h3 style="font-size: var(--f-size-xl); margin-bottom: var(--s-sm);">Ekspert LaTeX</h3>
          <p class="text-muted">Zaawansowana znajomość LaTeX, Quarto, R Markdown. <strong>11 publikacji</strong> przygotowanych do druku profesjonalnego.</p>
        </div>
        <div style="text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--c-primary), var(--c-accent)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s-md); font-size: 2rem;">💻</div>
          <h3 style="font-size: var(--f-size-xl); margin-bottom: var(--s-sm);">Programista</h3>
          <p class="text-muted">Automatyzacja procesów, skrypty Python/R do generowania treści. <strong>Git dla kontroli wersji</strong> publikacji.</p>
        </div>
      </div>

      <!-- Kompleksowa obsługa -->
      <div class="cta-section" style="margin-top: var(--s-3xl);">
        <div style="font-size: 2.5rem; margin-bottom: var(--s-md);">🏆</div>
        <h3 style="font-size: var(--f-size-2xl);">Kompleksowa obsługa = oszczędność czasu i pieniędzy</h3>
        <p>Nie musisz zatrudniać osobno: autora, redaktora, składacza i grafika. Dostajesz wszystko od jednej osoby - szybciej, taniej, sprawniej.</p>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-md); margin-top: var(--s-xl); max-width: 500px; margin-left: auto; margin-right: auto;">
          <div class="skill-group" style="text-align: center; padding: var(--s-md);">
            <div style="font-size: var(--f-size-2xl); font-weight: 800; color: var(--c-primary);">-50%</div>
            <div class="text-muted" style="font-size: var(--f-size-xs);">kosztów</div>
          </div>
          <div class="skill-group" style="text-align: center; padding: var(--s-md);">
            <div style="font-size: var(--f-size-2xl); font-weight: 800; color: var(--c-primary);">2x</div>
            <div class="text-muted" style="font-size: var(--f-size-xs);">szybciej</div>
          </div>
          <div class="skill-group" style="text-align: center; padding: var(--s-md);">
            <div style="font-size: var(--f-size-2xl); font-weight: 800; color: var(--c-primary);">1</div>
            <div class="text-muted" style="font-size: var(--f-size-xs);">kontakt</div>
          </div>
          <div class="skill-group" style="text-align: center; padding: var(--s-md);">
            <div style="font-size: var(--f-size-2xl); font-weight: 800; color: var(--c-primary);">100%</div>
            <div class="text-muted" style="font-size: var(--f-size-xs);">kontroli</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pakiety -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Pakiety <span class="text-gradient">publikacyjne</span></h2>
        <p>Od pojedynczego rozdziału po kompletną serię wydawniczą</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s-xl); max-width: 960px; margin: 0 auto;">
        {plans.map(plan => (
          <div class="skill-group" style={plan.best ? 'border-color: var(--c-primary); box-shadow: var(--c-glow); position: relative;' : ''}>
            {plan.best && <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--c-primary); color: #fff; padding: 2px 16px; border-radius: 999px; font-size: var(--f-size-xs); font-weight: 600;">Najpopularniejszy</div>}
            <div style="text-align: center; margin-bottom: var(--s-lg);">
              <h3 style="font-size: var(--f-size-2xl);">{plan.name}</h3>
              <div style="margin: var(--s-sm) 0;">
                {plan.price.includes('od') ? (
                  <span style="font-size: var(--f-size-3xl); font-weight: 800;">{plan.price}</span>
                ) : (
                  <><span style="font-size: var(--f-size-3xl); font-weight: 800;">{plan.price}</span><span class="text-muted"> zł netto</span></>
                )}
              </div>
              <p class="text-muted" style="font-size: var(--f-size-sm);">{plan.desc}</p>
            </div>
            <ul style="margin-bottom: var(--s-lg);">
              {plan.features.map(f => (
