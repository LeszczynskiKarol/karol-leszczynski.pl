    technologies: ["Astro 5", "TypeScript", "Tailwind CSS", "GA4", "GTM", "AWS"],
    link: "https://torweb.pl",
    year: "2025",
  },
  {
    title: "UniaTorun.pl",
    cat: "client",
    catLabel: "Sport / Strona firmowa",
    description: "Strona akademii piłkarskiej. 17 stron, custom video player, formularze zapisów, GDPR + Consent Mode v2.",
    technologies: ["Astro 5", "TypeScript", "Tailwind CSS", "GA4", "GTM", "AWS"],
    link: "https://www.uniatorun.pl",
    year: "2025",
  },
  {
    title: "GrandKuchnie.pl",
    cat: "client",
    catLabel: "Strona firmowa",
    description: "Strona producenta kuchni. Portfolio realizacji z CMS, galeria z lightbox, Google Analytics + Ads.",
    technologies: ["Next.js", "Prisma", "React", "AWS S3", "Tailwind CSS"],
    link: "https://grandkuchnie.pl",
