    stats: [{ label: "Użytkowników", value: "2000+" }, { label: "Prac wygenerowanych", value: "10k+" }],
  },
  {
    title: "Interpunkcja.com.pl",
    cat: "saas",
    catLabel: "SaaS / AI Tools",
