---

<Base title="Projekty — Portfolio | Karol Leszczyński" description="Kilkaset zrealizowanych projektów: platformy SaaS z AI, sklepy e-commerce, strony firmowe, publikacje LaTeX. React, Astro, Node.js, AWS.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main>
    <section class="hero" style="min-height: 50vh;">
      <div class="hero-bg"><div class="hero-grid"></div></div>
      <div class="container">
        <div class="hero-content" style="max-width: 700px;">
          <Breadcrumbs items={[{ label: "Projekty" }]} />
          <h1 class="animate-in animate-delay-1">Moje <span class="text-gradient">projekty</span></h1>
          <p class="text-muted animate-in animate-delay-2" style="font-size: var(--f-size-lg); margin: var(--s-lg) 0 var(--s-xl);">
            Kilkadziesiąt zrealizowanych projektów — od platform SaaS z AI, przez sklepy e-commerce, po profesjonalne publikacje w LaTeX.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: var(--s-lg); font-size: var(--f-size-sm);">
            <span>⚡ +5 platform SaaS z AI</span>
            <span>🛒 +3 sklepy e-commerce</span>
            <span>🌐 +15 stron klientów</span>
            <span>📚 +20 publikacji LaTeX</span>
          </div>
        </div>
      </div>
    </section>



    <!-- Wszystkie -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Ostatnie <span class="text-gradient">realizacje</span></h2>
          <p>30 projektów w 8 kategoriach</p>
        </div>

        <div class="portfolio-wrapper">
          {categories.map((cat, i) => (
            <input type="radio" name="cat-filter" id={`filter-${cat.id}`} class="portfolio-radio" checked={i === 0} />
          ))}
          <div class="portfolio-filters">
            {categories.map(cat => (
              <label for={`filter-${cat.id}`} class="portfolio-filter-label">{cat.label} <span class="portfolio-filter-count">{cat.count}</span></label>
            ))}
          </div>

          <div class="portfolio-grid">
            {projects.map(project => (
              <div class="portfolio-card" data-cat={project.cat}>
                {project.image && (
                  <div class="portfolio-card-img">
                    <img src={project.image} alt={project.title} loading="lazy" width="400" height="225" />
                  </div>
                )}
                <div class="portfolio-card-body">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--s-sm);">
                    <span style="font-size: var(--f-size-xs); padding: 2px 10px; background: var(--c-primary-soft); border-radius: 999px; color: var(--c-primary);">{project.catLabel}</span>
                    <span class="text-muted" style="font-size: var(--f-size-xs);">{project.year}</span>
                  </div>
                  <h3 style="font-size: var(--f-size-lg); margin-bottom: var(--s-xs);">{project.title}</h3>
                  <p class="text-muted" style="font-size: var(--f-size-sm); margin-bottom: var(--s-md); line-height: 1.5;">{project.description}</p>
                  <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: var(--s-md);">
                    {project.technologies.slice(0, 4).map(t => (
                      <span style="font-size: 10px; padding: 1px 8px; background: var(--c-bg-alt); border-radius: var(--radius); border: 1px solid var(--c-border);">{t}</span>
                    ))}
                    {project.technologies.length > 4 && <span style="font-size: 10px; padding: 1px 8px; background: var(--c-bg-alt); border-radius: var(--radius);" class="text-muted">+{project.technologies.length - 4}</span>}
                  </div>
                  <a href={project.link} target={project.internal ? undefined : "_blank"} rel={project.internal ? undefined : "noopener noreferrer"} class="project-card-link" style="font-size: var(--f-size-sm);">
                    {project.internal ? "Szczegóły" : "Odwiedź"} →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    

    <!-- CTA -->
    <section class="section" style="background: var(--c-bg-alt);">
      <div class="container" style="max-width: 700px; text-align: center;">
        <h2>Masz pomysł na <span class="text-gradient">kolejny projekt</span>?</h2>
        <p class="text-muted" style="font-size: var(--f-size-lg); margin: var(--s-md) 0 var(--s-xl);">
          Każdy z tych projektów zaczął się od rozmowy. Opowiedz mi o swoim pomyśle — <strong>pierwsza konsultacja gratis</strong>.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-md); justify-content: center; margin-bottom: var(--s-xl);">
          <a href="/kontakt" class="btn btn-primary">Porozmawiajmy o Twoim projekcie →</a>
          <a href="tel:+48509370772" class="btn btn-outline">📞 509 370 772</a>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-lg); justify-content: center; font-size: var(--f-size-sm);" class="text-muted">
          <span>✅ 15+ lat doświadczenia</span>
          <span>✅ Pełen stack: front + back + infra</span>
          <span>✅ Własne produkty SaaS</span>
        </div>
      </div>
    </section>
  </main>

  <style>
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(440px, 1fr));
      gap: var(--s-xl);
      max-width: 1000px;
      margin: 0 auto;
    }
    @media (max-width: 520px) { .featured-grid { grid-template-columns: 1fr; } }

    .featured-card {
      background: var(--c-bg-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: var(--transition);
    }
    .featured-card:hover { border-color: var(--c-border-hover); transform: translateY(-2px); }
    .featured-card-img { aspect-ratio: 16/9; overflow: hidden; background: linear-gradient(135deg, var(--c-primary-soft), var(--c-accent-soft)); }
    .featured-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .featured-card:hover .featured-card-img img { transform: scale(1.03); }
    .featured-card-body { padding: var(--s-lg); }

    .portfolio-filters { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: var(--s-2xl); }
    .portfolio-radio { display: none; }
    .portfolio-filter-label {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 20px; border-radius: 999px; font-size: var(--f-size-sm); font-weight: 500;
