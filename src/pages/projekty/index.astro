    technologies: ["Astro", "AWS Lambda", "Google Places API", "AWS S3/CloudFront"],
    link: "https://meble-bydgoszcz.pl",
    year: "2024–2025",
  },
  {
    title: "Mekra.pl",
    cat: "client",
    catLabel: "Strona firmowa",
    description: "Strona firmowa z rozbudowaną strukturą podstron. Optymalizacja SEO, responsywny design, AWS hosting.",
    technologies: ["Astro", "Tailwind CSS", "AWS S3/CloudFront"],
