// Filter out duplicates
const displayProjects = projects.filter(p => !p.skip);
---

<Base title="Projekty — Portfolio | Karol Leszczyński" description="30+ zrealizowanych projektów: platformy SaaS z AI, sklepy e-commerce, strony firmowe, publikacje LaTeX. React, Astro, Node.js, AWS.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main>
    <!-- Hero -->
    <section class="hero" style="min-height: 50vh;">
      <div class="hero-bg"><div class="hero-grid"></div></div>
      <div class="container">
        <div class="hero-content" style="max-width: 700px;">
          <Breadcrumbs items={[{ label: "Projekty" }]} />
          <h1 class="animate-in animate-delay-1">Moje <span class="text-gradient">projekty</span></h1>
          <p class="text-muted animate-in animate-delay-2" style="font-size: var(--f-size-lg); margin: var(--s-lg) 0 var(--s-xl);">
            Kilkaset zrealizowanych projektów — od platform SaaS z AI, przez sklepy e-commerce, po profesjonalne publikacje w LaTeX. Każdy projekt to działający produkt z mierzalnymi wynikami.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: var(--s-lg); font-size: var(--f-size-sm);">
            <span>⚡ 4 platformy SaaS z AI</span>
            <span>🛒 3 sklepy e-commerce</span>
            <span>🌐 +20 stron klientów</span>
            <span>📚 +20 publikacji LaTeX</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Wyróżnione projekty -->
    <section class="section" style="background: var(--c-bg-alt);">
      <div class="container">
        <div class="section-header">
          <h2>Flagowe <span class="text-gradient">realizacje</span></h2>
          <p>Projekty z największym impactem biznesowym</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(450px, 1fr)); gap: var(--s-xl); max-width: 1000px; margin: 0 auto;">
          {displayProjects.filter(p => p.highlight && p.stats).map(project => (
            <div class="skill-group" style="padding: var(--s-xl);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--s-md);">
                <div>
                  <h3 style="font-size: var(--f-size-2xl);">{project.title}</h3>
                  <span class="text-primary" style="font-size: var(--f-size-sm);">{project.catLabel}</span>
                </div>
                <span class="text-muted" style="font-size: var(--f-size-sm);">{project.year}</span>
              </div>
              <p class="text-muted" style="font-size: var(--f-size-sm); margin-bottom: var(--s-lg);">{project.description}</p>
              {project.stats && (
                <div style="display: flex; gap: var(--s-lg); margin-bottom: var(--s-lg);">
                  {project.stats.map(s => (
                    <div>
                      <div style="font-size: var(--f-size-2xl); font-weight: 800; color: var(--c-primary);">{s.value}</div>
                      <div class="text-muted" style="font-size: var(--f-size-xs);">{s.label}</div>
                    </div>
                  ))}
                </div>
              )}
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--s-md);">
                {project.technologies.slice(0, 5).map(t => (
                  <span style="font-size: var(--f-size-xs); padding: 2px 10px; background: var(--c-primary-soft); border-radius: 999px; color: var(--c-primary);">{t}</span>
                ))}
                {project.technologies.length > 5 && <span style="font-size: var(--f-size-xs); padding: 2px 10px; background: var(--c-bg-alt); border-radius: 999px;" class="text-muted">+{project.technologies.length - 5}</span>}
              </div>
              {project.link !== "#" && (
                <a href={project.link} target={project.internal ? undefined : "_blank"} rel={project.internal ? undefined : "noopener noreferrer"} class="project-card-link">
                  {project.internal ? "Zobacz usługę" : "Odwiedź stronę"} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Wszystkie projekty z filtrami CSS -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Wszystkie <span class="text-gradient">realizacje</span></h2>
          <p>27 projektów w 6 kategoriach</p>
        </div>

        <!-- CSS-only filter: radios + labels + grid must be siblings -->
        <div class="portfolio-wrapper">
          {categories.map((cat, i) => (
            <Fragment>
              <input type="radio" name="cat-filter" id={`filter-${cat.id}`} class="portfolio-radio" checked={i === 0} />
            </Fragment>
          ))}
          <div class="portfolio-filters">
            {categories.map(cat => (
              <label for={`filter-${cat.id}`} class="portfolio-filter-label">{cat.label} <span class="portfolio-filter-count">{cat.count}</span></label>
            ))}
          </div>

          <div class="portfolio-grid">
          {displayProjects.map(project => (
            <div class={`portfolio-card`} data-cat={project.cat}>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--s-sm);">
                <span style="font-size: var(--f-size-xs); padding: 2px 10px; background: var(--c-primary-soft); border-radius: 999px; color: var(--c-primary);">{project.catLabel}</span>
                <span class="text-muted" style="font-size: var(--f-size-xs);">{project.year}</span>
              </div>
              <h3 style="font-size: var(--f-size-lg); margin-bottom: var(--s-xs);">{project.title}</h3>
              <p class="text-muted" style="font-size: var(--f-size-sm); margin-bottom: var(--s-md); line-height: 1.5;">{project.description}</p>
              <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: var(--s-md);">
                {project.technologies.slice(0, 4).map(t => (
                  <span style="font-size: 10px; padding: 1px 8px; background: var(--c-bg-alt); border-radius: var(--radius); border: 1px solid var(--c-border);">{t}</span>
                ))}
                {project.technologies.length > 4 && <span style="font-size: 10px; padding: 1px 8px; background: var(--c-bg-alt); border-radius: var(--radius);" class="text-muted">+{project.technologies.length - 4}</span>}
              </div>
              {project.link && project.link !== "#" && (
                <a href={project.link} target={project.internal ? undefined : "_blank"} rel={project.internal ? undefined : "noopener noreferrer"} class="project-card-link" style="font-size: var(--f-size-sm);">
                  {project.internal ? "Szczegóły" : "Odwiedź"} →
                </a>
              )}
            </div>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section" style="background: var(--c-bg-alt);">
      <div class="container" style="max-width: 700px; text-align: center;">
        <h2>Masz pomysł na <span class="text-gradient">kolejny projekt</span>?</h2>
        <p class="text-muted" style="font-size: var(--f-size-lg); margin: var(--s-md) 0 var(--s-xl);">
          Każdy z tych 27 projektów zaczął się od rozmowy. Opowiedz mi o swoim pomyśle — <strong>pierwsza konsultacja gratis</strong>.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-md); justify-content: center; margin-bottom: var(--s-xl);">
          <a href="/kontakt" class="btn btn-primary">Porozmawiajmy o Twoim projekcie →</a>
          <a href="tel:+48509370772" class="btn btn-outline">📞 509 370 772</a>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-lg); justify-content: center; font-size: var(--f-size-sm);" class="text-muted">
          <span>✅ 15+ lat doświadczenia</span>
          <span>✅ Pełen stack: front + back + infra</span>
          <span>✅ Własne produkty SaaS</span>
        </div>
      </div>
    </section>
  </main>

  <!-- CSS-only portfolio filter -->
  <style>
    .portfolio-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin-bottom: var(--s-2xl);
    }
    .portfolio-radio { display: none; }
    .portfolio-filter-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 20px;
      border-radius: 999px;
      font-size: var(--f-size-sm);
      font-weight: 500;
      cursor: pointer;
      background: var(--c-bg-card);
      border: 1px solid var(--c-border);
      transition: var(--transition);
    }
    .portfolio-filter-label:hover { border-color: var(--c-border-hover); }
    .portfolio-radio:checked + .portfolio-filter-label {
      background: var(--c-primary);
      color: #fff;
      border-color: var(--c-primary);
    }
    .portfolio-filter-count {
      font-size: 10px;
      opacity: 0.7;
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--s-lg);
      max-width: 1100px;
      margin: 0 auto;
    }
    .portfolio-card {
      background: var(--c-bg-card);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      padding: var(--s-lg);
      transition: var(--transition);
    }
    .portfolio-card:hover {
      border-color: var(--c-border-hover);
      transform: translateY(-2px);
    }

    /* CSS-only filter logic */
    #filter-all:checked ~ .portfolio-grid .portfolio-card { display: block; }
    #filter-saas:checked ~ .portfolio-grid .portfolio-card { display: none; }
    #filter-saas:checked ~ .portfolio-grid .portfolio-card[data-cat="saas"] { display: block; }
    #filter-ecommerce:checked ~ .portfolio-grid .portfolio-card { display: none; }
