  { id: "all", label: "Wszystkie", count: 27 },
  { id: "saas", label: "SaaS / AI", count: 4 },
  { id: "ecommerce", label: "E-commerce", count: 3 },
  { id: "publishing", label: "Publikacje", count: 2 },
  { id: "content", label: "Content / Blogi", count: 7 },
  { id: "client", label: "Strony klientów", count: 9 },
  { id: "edtech", label: "EdTech", count: 4 },
