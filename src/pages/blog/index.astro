---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique categories
const categories = [...new Set(allPosts.map(p => p.data.category))].sort();

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog — Karol Leszczyński",
  "description": "Artykuły o web developmencie, Astro, AWS, SEO i budowaniu produktów cyfrowych.",
  "author": { "@type": "Person", "name": "Karol Leszczyński" },
};

function estimateReadingTime(body: string | undefined, readingTime?: number): number {
  if (readingTime) return readingTime;
  if (!body) return 1;
  return Math.max(1, Math.ceil(body.split(/\s+/).length / 200));
}
---

<Base
  title="Blog programisty o programowaniu — artykuły o Web Dev, Astro i SEO | Karol Leszczyński"
  description="Artykuły o web developmencie, frameworku Astro, infrastrukturze AWS, SEO i budowaniu produktów cyfrowych. Praktyczna wiedza z perspektywy full-stack developera."
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="hero" style="min-height: 45vh;">
    <div class="hero-bg"><div class="hero-grid"></div></div>
    <div class="container">
      <div class="hero-content" style="max-width: 700px;">
        <Breadcrumbs items={[{ label: "Blog" }]} />
        <h1 class="animate-in animate-delay-1">
          <span class="text-gradient">Blog</span>
        </h1>
        <p class="text-muted animate-in animate-delay-2" style="font-size: var(--f-size-lg); margin: var(--s-lg) 0 var(--s-md);">
          Web development, Astro, AWS, SEO i budowanie produktów cyfrowych.
          Praktyczna wiedza, nie teoria.
        </p>
        <p class="font-mono text-muted animate-in animate-delay-3" style="font-size: var(--f-size-sm);">
          <span style="color: var(--c-accent);">const</span> articles = <span style="color: var(--c-primary);">{allPosts.length}</span>;
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: var(--s-xl);">
    <div class="container">

      {/* Category filters 
      {categories.length > 1 && (
        <div class="blog-filters">
          <button class="blog-filter-btn active" data-category="all">
            Wszystkie <span class="blog-filter-count">{allPosts.length}</span>
          </button>
          {categories.map(cat => {
            const count = allPosts.filter(p => p.data.category === cat).length;
            return (
              <button class="blog-filter-btn" data-category={cat}>
                {cat} <span class="blog-filter-count">{count}</span>
              </button>
            );
          })}
        </div>
      )}*/}

      {/* Posts grid */}
      {allPosts.length === 0 ? (
        <div style="text-align: center; padding: var(--s-4xl) 0;">
          <p class="font-mono text-muted" style="font-size: var(--f-size-lg);">
            <span style="color: var(--c-accent);">// </span>Wkrótce pojawią się artykuły...
          </p>
        </div>
      ) : (
        <div class="blog-grid">
          {allPosts.map(post => {
            const formattedDate = post.data.pubDate.toLocaleDateString('pl-PL', {
              year: 'numeric', month: 'short', day: 'numeric'
            });
            const rt = estimateReadingTime(post.body, post.data.readingTime);
            return (
              <a href={`/blog/${post.slug}`} class="blog-card" data-category={post.data.category}>
                {post.data.heroImage ? (
                  <div class="blog-card-image">
                    <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading="lazy" width="400" height="225" />
                  </div>
                ) : (
                  <div class="blog-card-image blog-card-image--placeholder">
                    <span class="font-mono" style="font-size: var(--f-size-3xl); opacity: 0.15;">&lt;/&gt;</span>
                  </div>
                )}
                <div class="blog-card-body">
                  <div class="blog-card-meta">
                    <span class="blog-card-category">{post.data.category}</span>
                    <span class="blog-card-time">{rt} min</span>
                  </div>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <div class="blog-card-bottom">
                    <time datetime={post.data.pubDate.toISOString()} class="blog-card-date">{formattedDate}</time>
                    <span class="blog-card-arrow">→</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}

    </div>
  </section>

  {/* Filter script */}
  <script is:inline>
  (function() {
    var btns = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('.blog-card');
    if (!btns.length) return;
    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var cat = btn.getAttribute('data-category');
        cards.forEach(function(card) {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
    // Handle URL param ?kategoria=
    var params = new URLSearchParams(window.location.search);
    var kat = params.get('kategoria');
    if (kat) {
      var target = document.querySelector('.blog-filter-btn[data-category="' + kat + '"]');
      if (target) target.click();
    }
  })();
  </script>
</Base>

<style>
  /* Filters */
  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: var(--s-2xl);
  }

  .blog-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    font-size: var(--f-size-sm);
    font-weight: 500;
    font-family: var(--f-body);
    color: var(--c-text-muted);
    background: var(--c-bg-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: var(--transition);
  }

  .blog-filter-btn:hover {
    border-color: var(--c-border-hover);
    color: var(--c-text);
  }

  .blog-filter-btn.active {
    background: var(--c-primary);
    color: #fff;
    border-color: var(--c-primary);
  }

  .blog-filter-count {
    font-size: 10px;
    opacity: 0.7;
  }

  /* Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--s-xl);
  }

  /* Card */
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--c-bg-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    text-decoration: none;
    color: inherit;
  }

  .blog-card:hover {
    border-color: var(--c-border-hover);
    transform: translateY(-4px);
    box-shadow: var(--c-shadow);
  }

  .blog-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--c-primary-soft), var(--c-accent-soft));
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.04);
  }

  .blog-card-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-card-body {
    padding: var(--s-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-sm);
  }

  .blog-card-category {
    font-size: var(--f-size-xs);
    font-weight: 600;
    color: var(--c-primary);
  }

  .blog-card-time {
    font-size: var(--f-size-xs);
    color: var(--c-text-muted);
    font-family: var(--f-mono);
  }

  .blog-card-title {
    font-size: var(--f-size-lg);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--s-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-desc {
    font-size: var(--f-size-sm);
    color: var(--c-text-muted);
    line-height: 1.6;
    margin-bottom: var(--s-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .blog-card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--s-sm);
    border-top: 1px solid var(--c-border);
  }

  .blog-card-date {
    font-size: var(--f-size-xs);
    color: var(--c-text-muted);
    font-family: var(--f-mono);
  }

  .blog-card-arrow {
    font-size: var(--f-size-lg);
    color: var(--c-primary);
    transition: var(--transition);
  }

  .blog-card:hover .blog-card-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
